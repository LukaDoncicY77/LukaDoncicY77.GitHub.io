{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "check:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare-deploy.ps1",
